# Copiar a .env (nunca commitear .env con valores reales) y completar.

# --- Django ---
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
# True en desarrollo; False en el servidor de producción.
DEBUG=True
# Separado por comas. En el servidor: 172.21.35.40,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# Vacío o sqlite = db.sqlite3. "postgres" = PostgreSQL con los datos de abajo.
DB_ENGINE=sqlite
DB_NAME=sistema_laboratorios
DB_USER=lab_app
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# --- Email (SendGrid) ---
# Vacío = los correos se imprimen en consola y no salen a nadie.
# Con una key válida = los correos se envían por SendGrid.
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@sistemalaboratorios.com
